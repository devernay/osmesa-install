+/**
+ * \file piglit_osmesa_framework.c
+ *
+ * A GL framework over OSMesa (Mesa's off-screen renderer): no window system,
+ * no Waffle, no GLX/EGL. The "window" is an RGBA buffer in memory, bound with
+ * OSMesaMakeCurrent, and swapping buffers does nothing. With -fbo, the test
+ * renders to an FBO, as with the Waffle FBO framework.
+ *
+ * The context is created with OSMesaCreateContextAttribs: a core profile if
+ * the test supports one, else (or if that fails) a compatibility profile.
+ * OSMesa has no context flags, so tests that require a debug context are
+ * skipped, and forward-compatible contexts are core contexts.
+ *
+ * GL functions are looked up with OSMesaGetProcAddress (see
+ * piglit-dispatch-init.c), which also works with a mangled OSMesa (mgl*
+ * entry points): it is given the unmangled gl* names.
+ */
+
+#include <assert.h>
+#include <stdio.h>
+#include <stdlib.h>
+#include <string.h>
+
+#include "piglit-util-gl.h"
+#include "piglit_gl_framework.h"
+#include "piglit_osmesa_framework.h"
+
+/* Declared here rather than including GL/osmesa.h, which includes GL/gl.h,
+ * which conflicts with piglit-dispatch. */
+#ifdef _WIN32
+#define PIGLIT_OSMESA_APIENTRY __stdcall
+#else
+#define PIGLIT_OSMESA_APIENTRY
+#endif
+
+#define PIGLIT_OSMESA_FORMAT                0x22
+#define PIGLIT_OSMESA_Y_UP                  0x11
+#define PIGLIT_OSMESA_DEPTH_BITS            0x30
+#define PIGLIT_OSMESA_STENCIL_BITS          0x31
+#define PIGLIT_OSMESA_ACCUM_BITS            0x32
+#define PIGLIT_OSMESA_PROFILE               0x33
+#define PIGLIT_OSMESA_CORE_PROFILE          0x34
+#define PIGLIT_OSMESA_COMPAT_PROFILE        0x35
+#define PIGLIT_OSMESA_CONTEXT_MAJOR_VERSION 0x36
+#define PIGLIT_OSMESA_CONTEXT_MINOR_VERSION 0x37
+
+typedef struct osmesa_context *OSMesaContext;
+
+extern OSMesaContext PIGLIT_OSMESA_APIENTRY
+OSMesaCreateContextAttribs(const int *attribList, OSMesaContext sharelist);
+extern void PIGLIT_OSMESA_APIENTRY
+OSMesaDestroyContext(OSMesaContext ctx);
+extern GLboolean PIGLIT_OSMESA_APIENTRY
+OSMesaMakeCurrent(OSMesaContext ctx, void *buffer, GLenum type,
+		  GLsizei width, GLsizei height);
+extern void PIGLIT_OSMESA_APIENTRY
+OSMesaPixelStore(GLint pname, GLint value);
+
+struct piglit_osmesa_framework {
+	struct piglit_gl_framework gl_fw;
+	OSMesaContext context;
+	void *buffer;
+};
+
+static struct piglit_osmesa_framework osmesa_fw;
+
+static void
+destroy(struct piglit_gl_framework *gl_fw)
+{
+	(void)gl_fw;
+	if (osmesa_fw.context) {
+		OSMesaMakeCurrent(NULL, NULL, 0, 0, 0);
+		OSMesaDestroyContext(osmesa_fw.context);
+		osmesa_fw.context = NULL;
+	}
+	free(osmesa_fw.buffer);
+	osmesa_fw.buffer = NULL;
+	piglit_gl_framework_teardown(&osmesa_fw.gl_fw);
+}
+
+static void
+run_test(struct piglit_gl_framework **pgl_fw, int argc, char *argv[])
+{
+	struct piglit_gl_framework *gl_fw = *pgl_fw;
+	enum piglit_result result = PIGLIT_PASS;
+
+	if (gl_fw->test_config->init)
+		gl_fw->test_config->init(argc, argv);
+	/* There is no window and no event loop: draw once, whether or
+	 * not the run is automatic. */
+	if (gl_fw->test_config->display)
+		result = gl_fw->test_config->display();
+	piglit_report_result(result);
+}
+
+static void
+swap_buffers(struct piglit_gl_framework *gl_fw)
+{
+	(void)gl_fw;
+	/* Nothing to swap: the buffer is single-buffered memory. */
+	glFlush();
+}
+
+static void
+post_redisplay(struct piglit_gl_framework *gl_fw)
+{
+	(void)gl_fw;
+}
+
+static void
+set_keyboard_func(struct piglit_gl_framework *gl_fw,
+		  void (*func)(unsigned char key, int x, int y))
+{
+	(void)gl_fw;
+	(void)func;
+}
+
+static void
+set_reshape_func(struct piglit_gl_framework *gl_fw,
+		 void (*func)(int w, int h))
+{
+	(void)gl_fw;
+	(void)func;
+}
+
+/**
+ * Create and make current an OSMesa context of the given profile and
+ * version. Returns false if OSMesa can't create it.
+ */
+static bool
+make_context_current(const struct piglit_gl_test_config *test_config,
+		     bool core, int version)
+{
+	int attribs[32];
+	int i = 0;
+	int visual = test_config->window_visual;
+
+	attribs[i++] = PIGLIT_OSMESA_FORMAT;
+	attribs[i++] = GL_RGBA;
+	/* Gallium OSMesa only has Z24 and Z16 (and Z24S8 with stencil);
+	 * always give the 24 bits that window-system visuals have. */
+	if (visual & (PIGLIT_GL_VISUAL_DEPTH | PIGLIT_GL_VISUAL_STENCIL)) {
+		attribs[i++] = PIGLIT_OSMESA_DEPTH_BITS;
+		attribs[i++] = 24;
+	}
+	if (visual & PIGLIT_GL_VISUAL_STENCIL) {
+		attribs[i++] = PIGLIT_OSMESA_STENCIL_BITS;
+		attribs[i++] = 8;
+	}
+	if (visual & PIGLIT_GL_VISUAL_ACCUM) {
+		attribs[i++] = PIGLIT_OSMESA_ACCUM_BITS;
+		attribs[i++] = 16;
+	}
+	attribs[i++] = PIGLIT_OSMESA_PROFILE;
+	attribs[i++] = core ? PIGLIT_OSMESA_CORE_PROFILE
+			    : PIGLIT_OSMESA_COMPAT_PROFILE;
+	attribs[i++] = PIGLIT_OSMESA_CONTEXT_MAJOR_VERSION;
+	attribs[i++] = version / 10;
+	attribs[i++] = PIGLIT_OSMESA_CONTEXT_MINOR_VERSION;
+	attribs[i++] = version % 10;
+	attribs[i++] = 0;
+	assert(i <= (int)(sizeof(attribs) / sizeof(attribs[0])));
+
+	osmesa_fw.context = OSMesaCreateContextAttribs(attribs, NULL);
+	if (!osmesa_fw.context) {
+		printf("piglit: info: OSMesa can't create a GL %d.%d %s "
+		       "context\n", version / 10, version % 10,
+		       core ? "core" : "compatibility");
+		return false;
+	}
+
+	if (!OSMesaMakeCurrent(osmesa_fw.context, osmesa_fw.buffer,
+			       GL_UNSIGNED_BYTE, test_config->window_width,
+			       test_config->window_height)) {
+		printf("piglit: error: OSMesaMakeCurrent failed\n");
+		piglit_report_result(PIGLIT_FAIL);
+	}
+	/* Row 0 is the bottom row, as in GL. */
+	OSMesaPixelStore(PIGLIT_OSMESA_Y_UP, 1);
+
+	piglit_dispatch_default_init(PIGLIT_DISPATCH_GL);
+	piglit_gl_invalidate_extensions();
+	return true;
+}
+
+static void
+destroy_context(void)
+{
+	OSMesaMakeCurrent(NULL, NULL, 0, 0, 0);
+	OSMesaDestroyContext(osmesa_fw.context);
+	osmesa_fw.context = NULL;
+	piglit_gl_invalidate_extensions();
+}
+
+/**
+ * Same logic as the Waffle framework: a core context if the test supports
+ * one (GL 3.1 contexts must lack GL_ARB_compatibility), else a compatibility
+ * context of at least the requested version.
+ */
+static void
+choose_context(const struct piglit_gl_test_config *test_config)
+{
+	int core_version = test_config->supports_gl_core_version;
+	int compat_version = test_config->supports_gl_compat_version;
+
+	if (core_version) {
+		/* OSMesa has no forward-compatible flag; a 3.1 core
+		 * context is asked for as 3.2 core, which has no
+		 * GL_ARB_compatibility. */
+		if (make_context_current(test_config, true,
+					 core_version == 31 ? 32 : core_version)) {
+			int actual = piglit_get_gl_version();
+			if (actual >= core_version) {
+				piglit_is_core_profile = !piglit_is_extension_supported(
+					"GL_ARB_compatibility");
+				return;
+			}
+			printf("piglit: info: Requested a GL %d.%d core context, "
+			       "but got %d.%d\n", core_version / 10,
+			       core_version % 10, actual / 10, actual % 10);
+			destroy_context();
+		}
+		if (compat_version)
+			printf("piglit: info: Falling back to GL %d.%d "
+			       "compatibility context\n",
+			       compat_version / 10, compat_version % 10);
+	}
+
+	piglit_is_core_profile = false;
+
+	if (compat_version) {
+		if (make_context_current(test_config, false, compat_version)) {
+			int actual = piglit_get_gl_version();
+			if (actual < compat_version) {
+				printf("piglit: info: Requested a GL %d.%d "
+				       "compatibility context, but got %d.%d\n",
+				       compat_version / 10, compat_version % 10,
+				       actual / 10, actual % 10);
+				piglit_report_result(PIGLIT_SKIP);
+			}
+			if (compat_version == 31 &&
+			    !piglit_is_extension_supported("GL_ARB_compatibility")) {
+				printf("piglit: info: Failed to create a compat profile\n");
+				piglit_report_result(PIGLIT_SKIP);
+			}
+			return;
+		}
+	}
+
+	printf("piglit: info: Failed to create any GL context\n");
+	piglit_report_result(PIGLIT_SKIP);
+}
+
+/**
+ * The -fbo mode: render to a texture-backed FBO instead of the OSMesa
+ * buffer, as piglit_fbo_framework.c does. Returns false (and the test then
+ * renders to the OSMesa buffer) if the context can't.
+ */
+static bool
+init_fbo(const struct piglit_gl_test_config *test_config)
+{
+	GLuint tex, depth = 0;
+	GLenum status;
+
+	if (piglit_get_gl_version() < 20 ||
+	    !piglit_is_extension_supported("GL_ARB_framebuffer_object"))
+		return false;
+
+	glGenFramebuffers(1, &piglit_winsys_fbo);
+	glBindFramebuffer(GL_FRAMEBUFFER, piglit_winsys_fbo);
+
+	glGenTextures(1, &tex);
+	glBindTexture(GL_TEXTURE_2D, tex);
+	glTexParameteri(GL_TEXTURE_2D, GL_TEXTURE_MIN_FILTER, GL_NEAREST);
+	glTexParameteri(GL_TEXTURE_2D, GL_TEXTURE_MAG_FILTER, GL_NEAREST);
+	glTexImage2D(GL_TEXTURE_2D, 0, GL_RGBA, piglit_width, piglit_height,
+		     0, GL_RGBA, GL_UNSIGNED_BYTE, NULL);
+	glFramebufferTexture2D(GL_FRAMEBUFFER, GL_COLOR_ATTACHMENT0,
+			       GL_TEXTURE_2D, tex, 0);
+
+	if (test_config->window_visual & (PIGLIT_GL_VISUAL_DEPTH |
+					  PIGLIT_GL_VISUAL_STENCIL)) {
+		glGenTextures(1, &depth);
+		glBindTexture(GL_TEXTURE_2D, depth);
+		glTexParameteri(GL_TEXTURE_2D, GL_TEXTURE_MIN_FILTER, GL_NEAREST);
+		glTexParameteri(GL_TEXTURE_2D, GL_TEXTURE_MAG_FILTER, GL_NEAREST);
+		glTexImage2D(GL_TEXTURE_2D, 0, GL_DEPTH_STENCIL,
+			     piglit_width, piglit_height, 0,
+			     GL_DEPTH_STENCIL, GL_UNSIGNED_INT_24_8, NULL);
+		glFramebufferTexture2D(GL_FRAMEBUFFER, GL_DEPTH_ATTACHMENT,
+				       GL_TEXTURE_2D, depth, 0);
+		glFramebufferTexture2D(GL_FRAMEBUFFER, GL_STENCIL_ATTACHMENT,
+				       GL_TEXTURE_2D, depth, 0);
+	}
+
+	glBindTexture(GL_TEXTURE_2D, 0);
+
+	status = glCheckFramebufferStatus(GL_FRAMEBUFFER);
+	if (status != GL_FRAMEBUFFER_COMPLETE) {
+		fprintf(stderr, "framebuffer status is incomplete, falling "
+			"back to the OSMesa buffer\n");
+		glBindFramebuffer(GL_FRAMEBUFFER, 0);
+		glDeleteFramebuffers(1, &piglit_winsys_fbo);
+		glDeleteTextures(1, &depth);
+		glDeleteTextures(1, &tex);
+		piglit_winsys_fbo = 0;
+		return false;
+	}
+	return true;
+}
+
+struct piglit_gl_framework*
+piglit_osmesa_framework_create(const struct piglit_gl_test_config *test_config)
+{
+	if (test_config->window_samples > 1) {
+		puts("OSMesa doesn't support multisample visuals");
+		piglit_report_result(PIGLIT_SKIP);
+	}
+	if (test_config->require_debug_context) {
+		puts("OSMesa can't create debug contexts");
+		piglit_report_result(PIGLIT_SKIP);
+	}
+
+	if (!piglit_gl_framework_init(&osmesa_fw.gl_fw, test_config))
+		return NULL;
+
+	osmesa_fw.buffer = calloc((size_t)test_config->window_width *
+				  test_config->window_height, 4);
+	if (!osmesa_fw.buffer) {
+		puts("piglit: error: out of memory");
+		piglit_report_result(PIGLIT_FAIL);
+	}
+
+	choose_context(test_config);
+
+	if (piglit_use_fbo && !test_config->requires_displayed_window &&
+	    !init_fbo(test_config))
+		piglit_use_fbo = false;
+
+	osmesa_fw.gl_fw.run_test = run_test;
+	osmesa_fw.gl_fw.swap_buffers = swap_buffers;
+	osmesa_fw.gl_fw.post_redisplay = post_redisplay;
+	osmesa_fw.gl_fw.set_keyboard_func = set_keyboard_func;
+	osmesa_fw.gl_fw.set_reshape_func = set_reshape_func;
+	/* Not registered with piglit_set_destroy_func: piglit_report_result
+	 * may run on the timeout thread, while the test still renders. */
+	osmesa_fw.gl_fw.destroy = destroy;
+
+	return &osmesa_fw.gl_fw;
+}
